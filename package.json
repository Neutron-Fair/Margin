{
  "name": "coilbook-cost",
  "version": "1.2.2",
  "private": true,
  "description": "线圈本全工艺成本核算 / CoilBook Cost",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5199",
    "prepare:assets": "node tools/prepare-ocr-assets.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run prepare:assets && tsc --noEmit && vite build",
    "build:fast": "npm run prepare:assets && vite build",
    "test": "node --test",
    "verify": "node tools/verify.mjs",
    "verify:ocr": "node tools/verify.mjs --ocr",
    "dist:win": "npm run build && electron-builder --win nsis",
    "cap:sync": "npm run build && cap sync android",
    "apk:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.coilbook.cost",
    "productName": "CoilBookCost",
    "copyright": "CoilBook Cost",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "线圈本成本核算",
    "include": "build/installer.nsh",
      "artifactName": "CoilBookCost-Setup-${version}.${ext}"
    }
  }
}